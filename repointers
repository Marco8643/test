local function getCar()
local car 
local plr = game.Players.LocalPlayer
local chr = plr.Character
local hum = chr.Humanoid
local seat = hum.SeatPart 
if seat and seat.Parent
and seat.Parent:IsA("Model") and  seat.Parent.Parent.ClassName ~= "Model" then
car = seat.Parent
elseif seat and seat.Parent
and seat.Parent:IsA("Folder")
and seat.Parent.Parent:IsA("Model") or
seat.Parent.Parent:IsA("Model") and  seat.Parent.Parent.Parent.ClassName ~= "Model"   then
car = seat.Parent.Parent
elseif seat and seat.Parent
and seat.Parent:IsA("Folder")
and seat.Parent.Parent:IsA("Folder")
and seat.Parent.Parent.Parent.ClassName ~= "Model"  then
    car = seat.Parent.Parent.Parent
end 
return car
end 
local function getWeight(value)
local weight
for i,v in pairs(value:GetDescendants()) do
    if string.find(v.Name,"eight") and v:IsA("BasePart") then
     weight = v
    end   
end
if not weight then
  local minsize = 0
for i,v in pairs(value:GetDescendants()) do
    if v:IsA("BasePart") and not v.Massless  then
      local size = v.Size.X
      if size > minsize then
        minsize = size
     weight = v
      end
    end   
end
end
return weight
end
